# ===== Основное =====
# Домен, на котором будет доступно приложение (без https://)
DOMAIN=hr.example.ru
# Полный внешний адрес (HTTPS обязателен для Битрикс24 и hh.ru)
PUBLIC_URL=https://hr.example.ru

# Секрет для шифрования токенов в БД и подписи сессий. Сгенерировать: openssl rand -hex 32
# ВНИМАНИЕ: если поменять — все сохранённые токены станут нечитаемыми, придётся переподключать.
SECRET_KEY=

# Пароль базы данных PostgreSQL (любой длинный). Сгенерировать: openssl rand -hex 16
POSTGRES_PASSWORD=

# Какие порталы Битрикс24 могут пользоваться сервером, через запятую.
# Пусто — любой портал (НЕ рекомендуется для продакшена).
ALLOWED_PORTALS=client1.bitrix24.ru,client2.bitrix24.ru

# Локальный порт приложения (на него проксирует nginx)
APP_PORT=3000

# ===== hh.ru (приложение с dev.hh.ru) =====
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# Обязательный заголовок для API hh.ru: Название/версия (контактный email)
HH_USER_AGENT=NewFlatHRConnector/1.0 (support@example.ru)
# Событие вебхука hh.ru о новом отклике. Оставьте пустым, чтобы использовать только опрос по расписанию.
HH_WEBHOOK_EVENT=NEW_NEGOTIATION_VACANCY

# ===== Тонкие настройки (можно не трогать) =====
# WORKER_TICK_SECONDS=15
# MAX_ATTEMPTS=8
# LOG_RETENTION_DAYS=30
# LOG_LEVEL=info
