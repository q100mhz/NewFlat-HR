# Пример для существующего nginx. Скопируйте в /etc/nginx/sites-available/hr.conf,
# замените hr.example.ru и пути к сертификатам, затем:
#   sudo ln -s /etc/nginx/sites-available/hr.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Сертификат можно выпустить так: sudo certbot --nginx -d hr.example.ru

server {
    listen 80;
    server_name hr.example.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name hr.example.ru;

    ssl_certificate     /etc/letsencrypt/live/hr.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hr.example.ru/privkey.pem;

    client_max_body_size 5m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
}
